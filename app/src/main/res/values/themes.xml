<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Thème de base avec ActionBar -->
    <style name="Theme.TaskFire" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Couleurs primaires -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Couleurs secondaires -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Couleur de la barre d'état -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Personnalisez d'autres attributs ici -->
    </style>

    <!-- Thème sans ActionBar pour l'activité personnalisée -->
    <style name="Theme.TaskFire.NoActionBar" parent="Theme.TaskFire">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Thèmes complémentaires pour AppBar et Popup -->
    <style name="Theme.TaskFire.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.TaskFire.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
